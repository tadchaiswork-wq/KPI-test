rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ระบบนี้จัดการล็อกอิน/สิทธิ์ในระดับแอป (ไม่ใช้ Firebase Authentication)
    // Firestore จึงไม่รู้ว่าใครเป็นผู้เรียก — กติกาด้านล่างจึงเปิดให้อ่าน/เขียนได้
    // เหมาะสำหรับใช้งานภายในโรงพยาบาล (คนที่มี URL + โค้ดแอปเท่านั้นที่เข้าถึง)
    // การอนุมัติผู้ใช้ สิทธิ์ admin และการควบคุมการแก้ไข อยู่ในตัวแอป
    //
    // หากต้องการความปลอดภัยระดับสูงขึ้นในอนาคต ให้เปลี่ยนไปใช้ Firebase Authentication
    // แล้วปรับกติกาให้ตรวจ request.auth

    match /indicators/{id} { allow read, write: if true; }
    match /wards/{id}      { allow read, write: if true; }
    match /users/{id}      { allow read, write: if true; }
    match /chat/{id}       { allow read, write: if true; }
    match /meta/{id}       { allow read, write: if true; }

    // ปฏิเสธ path อื่น ๆ ที่ไม่ได้ใช้
    match /{document=**}   { allow read, write: if false; }
  }
}
